# Leave credentials empty in source control.
KINTONE_BASE_URL=
KINTONE_USERNAME=
KINTONE_PASSWORD=
KINTONE_API_TOKEN=

# Example multi-environment credential references. Use distinct credentials
# per environment. The names must match environments.yaml; values stay local.
CUSTOMER_SOURCE_ADMIN_USERNAME=
CUSTOMER_SOURCE_ADMIN_PASSWORD=
LAB1_ADMIN_USERNAME=
LAB1_ADMIN_PASSWORD=
LAB2_ADMIN_USERNAME=
LAB2_ADMIN_PASSWORD=
LAB3_ADMIN_USERNAME=
LAB3_ADMIN_PASSWORD=
CUSTOMER_TARGET_ADMIN_USERNAME=
CUSTOMER_TARGET_ADMIN_PASSWORD=
CUSTOMER_TARGET_PFX_PATH=
CUSTOMER_TARGET_PFX_PASSWORD=

# Optional official MCP settings.
KINTONE_BASIC_AUTH_USERNAME=
KINTONE_BASIC_AUTH_PASSWORD=
KINTONE_PFX_FILE_PATH=
KINTONE_PFX_FILE_PASSWORD=
KINTONE_ATTACHMENTS_DIR=
HTTPS_PROXY=

# This is a Steward policy flag, not an official MCP security control.
# Mutating operations also require implementation support and explicit approval.
KINTONE_ALLOW_CHANGES=false
